# Exposure policy: docs/services.md. Routes are explicit per service.

dns.{{ homelab_domain }} {
    import tls_cloudflare
    import private_only
    # AdGuard uses host networking (DHCP), so target the host IP
    reverse_proxy 10.0.0.10:3000
}

auth.{{ homelab_domain }} {
    import tls_cloudflare
    reverse_proxy authentik:9000
}

home.{{ homelab_domain }} {
    import tls_cloudflare
    import private_only
    # Home Assistant is host-networked, so target the host IP
    reverse_proxy 10.0.0.10:8123
}

