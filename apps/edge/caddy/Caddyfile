{
    email {{ acme_email }}
}

# Official syntax: https://github.com/caddy-dns/cloudflare
(tls_cloudflare) {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
}

# Internal-only: LAN/VPN source ranges, everyone else gets 403
(private_only) {
    @not_private not remote_ip private_ranges
    respond @not_private 403
}

# Per-service forward-auth, per https://docs.goauthentik.io/add-secure-apps/providers/proxy/server_caddy
