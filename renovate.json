{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:weekly"],
  "timezone": "Europe/Paris",
  "packageRules": [
    {
      "description": "Batch non-major updates into one weekly PR; majors get their own PR for review",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "non-major updates"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update SOPS version used by Ansible",
      "managerFilePatterns": ["/^configure/group_vars/all\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nsops_version:\\s*(?<currentValue>\\S+)"
      ]
    }
  ]
}
