#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "--offsite" ]]; then
    export RESTIC_REPOSITORY={{ edge_restic_offsite_repo | default('') | quote }}
    export RESTIC_PASSWORD_FILE={{ edge_restic_offsite_password_file | default('') | quote }}
    # shellcheck disable=SC1090
    source {{ edge_restic_offsite_env_file | default('/dev/null') | quote }}
else
    export RESTIC_REPOSITORY={{ edge_restic_repo | quote }}
    export RESTIC_PASSWORD_FILE={{ edge_restic_password_file | quote }}
fi

{% for file_set in edge_restic_file_sets | default([]) %}
restic backup \
{% for path in file_set.paths %}
    {{ path | quote }} \
{% endfor %}
{% for tag in file_set.tags | default([]) %}
    --tag {{ tag | quote }} \
{% endfor %}
    --tag {{ file_set.name | quote }}

{% endfor %}
{% for job in edge_restic_stdin_jobs | default([]) %}
{{ job.command }} | restic backup \
    --stdin \
    --stdin-filename {{ job.filename | quote }} \
{% for tag in job.tags | default([]) %}
    --tag {{ tag | quote }} \
{% endfor %}
    --tag {{ job.name | quote }}

{% endfor %}
