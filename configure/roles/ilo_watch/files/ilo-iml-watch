#!/usr/bin/env python3
"""Alert on new Critical or Caution entries in the iLO Integrated Management Log.

The IML is where the server records what the OS cannot report itself: uncorrectable memory
errors, machine checks, ASR resets, POST errors and fan or power faults. One SSH session reads
the whole log. Entries newer than the last one seen are checked and the highest number is kept.
"""
import argparse
import json
import os
import re
import subprocess
import sys

p = argparse.ArgumentParser()
p.add_argument("--host", required=True)
p.add_argument("--user", required=True)
p.add_argument("--key", required=True)
p.add_argument("--known-hosts", required=True)
p.add_argument("--state", default="/var/lib/ilo-iml-watch/state.json")
p.add_argument("--ignore", default="", help="regex of descriptions to skip")
a = p.parse_args()


def notify(prio, title, msg):
    try:
        subprocess.run(["/usr/local/sbin/homelab-notify", prio, title, msg], check=False)
    except OSError:
        print(f"{title}: {msg}", file=sys.stderr)


cmd = [
    "ssh", "-i", a.key, "-o", "IdentitiesOnly=yes", "-o", "BatchMode=yes",
    "-o", "ConnectTimeout=10", "-o", f"UserKnownHostsFile={a.known_hosts}",
    "-o", "StrictHostKeyChecking=accept-new",
    "-o", "KexAlgorithms=+diffie-hellman-group14-sha1",
    "-o", "HostKeyAlgorithms=+ssh-rsa", "-o", "PubkeyAcceptedAlgorithms=+ssh-rsa",
    f"{a.user}@{a.host}", "show -a /system1/log1",
]
try:
    out = subprocess.run(cmd, capture_output=True, text=True, timeout=90, errors="replace").stdout
except subprocess.TimeoutExpired:
    out = ""

records = {}
for block in re.split(r"\n(?=/system1/log1/record\d+)", out.replace("\r", "")):
    m = re.match(r"/system1/log1/record(\d+)", block)
    if not m:
        continue
    fields = dict(re.findall(r"^\s+(severity|date|time|description)=(.*)$", block, re.M))
    records[int(m.group(1))] = fields

if not records:
    # An empty read is not proof of anything. Stay quiet but leave a trace in the journal.
    print("no IML records read", file=sys.stderr)
    sys.exit(1)

try:
    with open(a.state) as f:
        last = json.load(f)["last"]
except (OSError, ValueError, KeyError):
    last = None

top = max(records)
if last is None:
    print(f"first run, starting after record {top}")
else:
    if top < last:
        # The log was cleared. Everything in it is new.
        last = 0
    ignore = re.compile(a.ignore) if a.ignore else None
    alerts = []
    for n in sorted(k for k in records if k > last):
        r = records[n]
        if r.get("severity") not in ("Critical", "Caution"):
            continue
        if ignore and ignore.search(r.get("description", "")):
            continue
        alerts.append(f"#{n} {r.get('date', '')} {r.get('time', '')} {r['severity']}: {r.get('description', '')}")
    if alerts:
        prio = "urgent" if any("Critical" in x for x in alerts) else "high"
        notify(prio, "iLO IML", "\n".join(alerts))
    print(f"checked records {last + 1}-{top}, {len(alerts)} alert(s)")

os.makedirs(os.path.dirname(a.state), exist_ok=True)
with open(a.state, "w") as f:
    json.dump({"last": top}, f)
