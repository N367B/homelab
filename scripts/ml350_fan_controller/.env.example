# Use your SSH config alias if you have one.
# ILO_TARGET=ilo
ILO_TARGET=10.0.0.3

# Leave empty if using SSH keys.
ILO_PASSWORD=

# Only needed if you are NOT using a working ssh config alias.
# Example:
# ILO_SSH_OPTIONS=-o KexAlgorithms=+diffie-hellman-group14-sha1 -o HostKeyAlgorithms=+ssh-rsa -o PubkeyAcceptedAlgorithms=+ssh-rsa -o StrictHostKeyChecking=accept-new
ILO_SSH_OPTIONS=-l Administrator -i /path/to/your/id_rsa -o KexAlgorithms=+diffie-hellman-group14-sha1 -o HostKeyAlgorithms=+ssh-rsa -o PubkeyAcceptedAlgorithms=+ssh-rsa -o StrictHostKeyChecking=accept-new

CHANNELS=0,1,2,3,4,5,6,7

SSH_CONNECT_TIMEOUT=5
ILO_PROMPT_TIMEOUT=10
SMART_POLL_SECONDS=120

SAFE_FALLBACK_PWM=128
TEMP_FAILURE_SAFE_AFTER=3

DOWN_STEP=16
MIN_CHANGE=8
LOG_EVERY_RUN=0

# Usually leave this off.
ALWAYS_START_CONTROLLER=0

# If normal apply fails, retry once with "fan g start" first.
RETRY_WITH_FAN_G_START=1
